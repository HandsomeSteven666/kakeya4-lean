import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Sigma
import Mathlib.Data.Finset.Card
import Mathlib.Basic.Real.Basic
import Mathlib.Tactic

/-!
# Finite graph counting for the retained-edge BSG lemma

The graph BSG proof begins with degree counting. This file contains the retained-edge witness and reusable finite counting facts used by the
curated proof of `Kakeya4.GraphBalogSzemerediGowers` in `Hard/Externals/Statements.lean`.
-/

set_option autoImplicit false

namespace Kakeya4.GraphBSG

/-- The left degree of `a` in an edge set of ordered pairs. Edges are counted with their
original identity in `E`; no graph is replaced by its image or by an energy statistic. -/
def leftDegree {G : Type*} [DecidableEq G] (E : Finset (G × G)) (a : G) : ℕ :=
  (E.filter fun e => e.1 = a).card

/-- Left vertices adjacent to a fixed right vertex in the original edge set. -/
def leftNeighborhood {G : Type*} [DecidableEq G]
    (A : Finset G) (E : Finset (G × G)) (b : G) : Finset G :=
  A.filter fun a => (a, b) ∈ E

/-- Number of original edges from a selected left set into a fixed right vertex. -/
def rightDegreeOnLeft {G : Type*} [DecidableEq G]
    (A' : Finset G) (E : Finset (G × G)) (b : G) : ℕ :=
  (leftNeighborhood A' E b).card

/-- Right vertices receiving at least the prescribed fraction of the selected left set. -/
noncomputable def goodRightVertices {G : Type*} [DecidableEq G]
    (θ : ℝ) (A' B : Finset G) (E : Finset (G × G)) : Finset G :=
  B.filter fun b => θ * (A'.card : ℝ) / 4 ≤ (rightDegreeOnLeft A' E b : ℝ)

/-- Cardinality of a left neighborhood equals the corresponding left fiber size. -/
theorem leftDegree_eq_neighborCard {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B) (a : G) :
    leftDegree E a = (B.filter fun b => (a, b) ∈ E).card := by
  classical
  apply Finset.card_bij (s := E.filter fun e => e.1 = a)
    (t := B.filter fun b => (a, b) ∈ E) (fun e _ => e.2)
  · intro e he
    have he' := Finset.mem_filter.mp he
    have heAB := Finset.mem_product.mp (hE he'.1)
    have hpair : (a, e.2) = e := Prod.ext he'.2.symm rfl
    exact Finset.mem_filter.mpr ⟨heAB.2, hpair ▸ he'.1⟩
  · intro e he e' he' h
    have hefst := (Finset.mem_filter.mp he).2
    have hefst' := (Finset.mem_filter.mp he').2
    exact Prod.ext (hefst.trans hefst'.symm) h
  · intro b hb
    have hb' := Finset.mem_filter.mp hb
    refine ⟨(a, b), ?_, rfl⟩
    exact Finset.mem_filter.mpr ⟨hb'.2, rfl⟩


/-- Common right neighbors of an ordered pair of left vertices. -/
def commonRightNeighbors {G : Type*} [DecidableEq G]
    (B : Finset G) (E : Finset (G × G)) (a a' : G) : Finset G :=
  B.filter fun b => (a, b) ∈ E ∧ (a', b) ∈ E

/-- Ordered left pairs whose common neighborhood is below the `τ` threshold. -/
noncomputable def badLeftPairs {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (τ : ℝ) : Finset (G × G) :=
  (A ×ˢ A).filter fun p =>
    (commonRightNeighbors B E p.1 p.2).card < τ * (B.card : ℝ)

/-- Bad ordered pairs whose two endpoints both lie in the neighborhood of `b`. -/
noncomputable def badPairsAtRightVertex {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (τ : ℝ) (b : G) : Finset (G × G) :=
  (badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E

/-- Middle-vertex and intermediate-right-vertex pairs describing three-edge walks
`u -- v₁ -- u₁ -- v` in the original edge set. -/
def threeEdgeWalks {G : Type*} [DecidableEq G]
    (A' B : Finset G) (E : Finset (G × G)) (u v : G) : Finset (G × G) :=
  (A' ×ˢ B).filter fun w =>
    (u, w.2) ∈ E ∧ (w.1, w.2) ∈ E ∧ (w.1, v) ∈ E

/-- The finite sumset generated by the original graph edges. -/
def retainedGraphSumSet {G : Type*} [Add G] [DecidableEq G]
    (E : Finset (G × G)) : Finset G := E.image fun e => e.1 + e.2

/-- The three sums attached to a walk `u -- v₁ -- u₁ -- v`. -/
def threeEdgeWalkSums {G : Type*} [Add G] (u v : G) (w : G × G) : G × (G × G) :=
  (u + w.2, (w.1 + w.2, w.1 + v))

/-- Encoded triples arising from walks between a fixed pair of endpoints. -/
def threeEdgeWalkCodeSet {G : Type*} [Add G] [DecidableEq G]
    (A' B : Finset G) (E : Finset (G × G)) (u v : G) : Finset (G × (G × G)) :=
  (threeEdgeWalks A' B E u v).image (threeEdgeWalkSums u v)

/-- Endpoint sums represented by a pair from the selected left and right sets. -/
def endpointSumSet {G : Type*} [Add G] [DecidableEq G]
    (A' B : Finset G) : Finset G :=
  (A' ×ˢ B).image fun p => p.1 + p.2

/-- `endpointSumSet` is exactly the manuscript's finite sumset image. -/
theorem endpointSumSet_eq_product_image {G : Type*} [Add G] [DecidableEq G]
    (A' B : Finset G) :
    endpointSumSet A' B = (A'.product B).image fun p => p.1 + p.2 := rfl

/-- The alternating sum of a walk code recovers the sum of its endpoints. -/
theorem threeEdgeWalkSums_alternating {G : Type*} [AddCommGroup G]
    (u v : G) (w : G × G) :
    (threeEdgeWalkSums u v w).1 - (threeEdgeWalkSums u v w).2.1 +
      (threeEdgeWalkSums u v w).2.2 = u + v := by
  dsimp [threeEdgeWalkSums]
  abel

/-- Codes of walks with different endpoint sums are disjoint. -/
theorem threeEdgeWalkCodeSet_disjoint_of_ne {G : Type*} [AddCommGroup G]
    [DecidableEq G] (A' B : Finset G) (E : Finset (G × G))
    (u v u' v' : G) (hsum : u + v ≠ u' + v') :
    Disjoint (threeEdgeWalkCodeSet A' B E u v)
      (threeEdgeWalkCodeSet A' B E u' v') := by
  classical
  apply Finset.disjoint_left.mpr
  intro code hcode hcode'
  rcases Finset.mem_image.mp hcode with ⟨w, hw, rfl⟩
  rcases Finset.mem_image.mp hcode' with ⟨w', hw', heq⟩
  have hcodeEq := congrArg (fun t : G × (G × G) => t.1 - t.2.1 + t.2.2) heq
  rw [threeEdgeWalkSums_alternating, threeEdgeWalkSums_alternating] at hcodeEq
  exact hsum hcodeEq.symm

/-- The walk code is injective for fixed endpoints. -/
theorem threeEdgeWalkSums_injectiveOn {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A' B : Finset G) (E : Finset (G × G)) (u v : G) :
    Set.InjOn (threeEdgeWalkSums u v) (threeEdgeWalks A' B E u v) := by
  intro w hw w' hw' heq
  have hwEdges := (Finset.mem_filter.mp hw).2
  have hw'Edges := (Finset.mem_filter.mp hw').2
  change (u + w.2, (w.1 + w.2, w.1 + v)) =
    (u + w'.2, (w'.1 + w'.2, w'.1 + v)) at heq
  have hv₁ : u + w.2 = u + w'.2 := congrArg Prod.fst heq
  have hv₁eq : w.2 = w'.2 := add_left_cancel hv₁
  have hu₁ : w.1 + w.2 = w'.1 + w'.2 := congrArg (fun t : G × (G × G) => t.2.1) heq
  rw [hv₁eq] at hu₁
  have hu₁eq : w.1 = w'.1 := add_right_cancel hu₁
  exact Prod.ext hu₁eq hv₁eq

/-- Every walk code belongs to the cube of the original graph sumset. -/
theorem threeEdgeWalkCodeSet_subset_sumset_cube {G : Type*} [AddCommGroup G]
    [DecidableEq G] (A' B : Finset G) (E : Finset (G × G)) (u v : G) :
    threeEdgeWalkCodeSet A' B E u v ⊆
      retainedGraphSumSet E ×ˢ (retainedGraphSumSet E ×ˢ retainedGraphSumSet E) := by
  classical
  intro code hcode
  rcases Finset.mem_image.mp hcode with ⟨w, hw, rfl⟩
  rcases Finset.mem_filter.mp hw with ⟨_, hedges⟩
  apply Finset.mem_product.mpr
  refine ⟨?_, Finset.mem_product.mpr ⟨?_, ?_⟩⟩
  · exact Finset.mem_image.mpr ⟨(u, w.2), hedges.1, rfl⟩
  · exact Finset.mem_image.mpr ⟨(w.1, w.2), hedges.2.1, rfl⟩
  · exact Finset.mem_image.mpr ⟨(w.1, v), hedges.2.2, rfl⟩

/-- If each endpoint sum is assigned one representing pair with at least `k` walks, then the
disjoint walk codes occupy at least `k` points per sum inside the cube of the original graph
sumset. This is the finite counting step used to derive the graph-BSG sumset estimate. -/
theorem endpointSumSet_card_mul_le_sumset_cube {G : Type*} [AddCommGroup G]
    [DecidableEq G] (A' B B₀ : Finset G) (E : Finset (G × G)) (k : ℝ)
    (hwalk : ∀ s ∈ endpointSumSet A' B₀,
      ∃ p : G × G, p.1 ∈ A' ∧ p.2 ∈ B₀ ∧ p.1 + p.2 = s ∧
        k ≤ (threeEdgeWalks A' B E p.1 p.2).card) :
    (endpointSumSet A' B₀).card * k ≤ (retainedGraphSumSet E).card ^ 3 := by
  classical
  let S := endpointSumSet A' B₀
  let C := retainedGraphSumSet E
  let rep : G → G × G := fun s =>
    if hs : s ∈ S then Classical.choose (hwalk s hs) else 0
  have hrep (s : G) (hs : s ∈ S) :
      (rep s).1 ∈ A' ∧ (rep s).2 ∈ B₀ ∧ (rep s).1 + (rep s).2 = s ∧
        k ≤ (threeEdgeWalks A' B E (rep s).1 (rep s).2).card := by
    simp only [rep, dite_eq_left hs]
    exact Classical.choose_spec (hwalk s hs)
  let codes : G → Finset (G × (G × G)) := fun s =>
    threeEdgeWalkCodeSet A' B E (rep s).1 (rep s).2
  have hdisj : (S : Set G).PairwiseDisjoint codes := by
    intro s hs t ht hst
    apply threeEdgeWalkCodeSet_disjoint_of_ne A' B E (rep s).1 (rep s).2
      (rep t).1 (rep t).2
    intro hsum
    apply hst
    calc
      s = (rep s).1 + (rep s).2 := (hrep s hs).2.2.1.symm
      _ = (rep t).1 + (rep t).2 := hsum
      _ = t := (hrep t ht).2.2.1
  have hUnionSub : S.biUnion codes ⊆ C ×ˢ (C ×ˢ C) := by
    apply Finset.biUnion_subset.mpr
    intro s hs
    exact threeEdgeWalkCodeSet_subset_sumset_cube A' B E (rep s).1 (rep s).2
  have hcardUnion :
      (S.biUnion codes).card = ∑ s ∈ S, (codes s).card := Finset.card_biUnion hdisj
  have hsumLower :
      ∑ s ∈ S, k ≤ ∑ s ∈ S, ((codes s).card : ℝ) := by
    apply Finset.sum_le_sum
    intro s hs
    have himage := Finset.card_image_of_injOn
      (threeEdgeWalkSums_injectiveOn A' B E (rep s).1 (rep s).2)
    have hcodecard : (codes s).card =
        (threeEdgeWalks A' B E (rep s).1 (rep s).2).card := by
      simpa [codes, threeEdgeWalkCodeSet] using himage
    have hcodecardReal : (codes s).card =
        (threeEdgeWalks A' B E (rep s).1 (rep s).2).card := hcodecard
    have hk := (hrep s hs).2.2.2
    rw [hcodecardReal]
    exact hk
  calc
    (S.card : ℝ) * k = ∑ s ∈ S, k := by simp
    _ ≤ ∑ s ∈ S, ((codes s).card : ℝ) := hsumLower
    _ = (S.biUnion codes).card := by rw [hcardUnion]; simp
    _ ≤ (C ×ˢ (C ×ˢ C)).card := by exact_mod_cast Finset.card_le_card hUnionSub
    _ = C.card ^ 3 := by simp [Finset.card_product]; ring

/-- Enlarging the edge set can only add three-edge walks. -/
theorem threeEdgeWalks_mono {G : Type*} [DecidableEq G]
    (A' B : Finset G) (E₁ E₂ : Finset (G × G)) (u v : G)
    (hE : E₁ ⊆ E₂) :
    threeEdgeWalks A' B E₁ u v ⊆ threeEdgeWalks A' B E₂ u v := by
  classical
  intro w hw
  rcases Finset.mem_filter.mp hw with ⟨hwAB, hwalk⟩
  exact Finset.mem_filter.mpr ⟨hwAB, hE hwalk.1, hE hwalk.2.1, hE hwalk.2.2⟩

/-- For fixed endpoints, the alternating-sum encoding of a three-edge walk injects into the
cube of the original graph sumset. The first two coordinates recover `v₁` and then `u₁`. -/
theorem card_threeEdgeWalks_le_sumset_cube {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A' B : Finset G) (E : Finset (G × G)) (u v : G) :
    (threeEdgeWalks A' B E u v).card ≤ (retainedGraphSumSet E).card ^ 3 := by
  classical
  let C := retainedGraphSumSet E
  have hinj : ∀ w ∈ threeEdgeWalks A' B E u v,
      ∀ w' ∈ threeEdgeWalks A' B E u v,
        threeEdgeWalkSums u v w = threeEdgeWalkSums u v w' → w = w' := by
    intro w hw w' hw' heq
    have hwEdges := (Finset.mem_filter.mp hw).2
    have hw'Edges := (Finset.mem_filter.mp hw').2
    change (u + w.2, (w.1 + w.2, w.1 + v)) =
      (u + w'.2, (w'.1 + w'.2, w'.1 + v)) at heq
    have hv₁ : u + w.2 = u + w'.2 := congrArg Prod.fst heq
    have hv₁eq : w.2 = w'.2 := add_left_cancel hv₁
    have hu₁ : w.1 + w.2 = w'.1 + w'.2 := congrArg (fun t : G × (G × G) => t.2.1) heq
    rw [hv₁eq] at hu₁
    have hu₁eq : w.1 = w'.1 := add_right_cancel hu₁
    exact Prod.ext hu₁eq hv₁eq
  have hcard := Finset.card_le_card_of_injOn
    (s := threeEdgeWalks A' B E u v)
    (t := C ×ˢ (C ×ˢ C))
    (threeEdgeWalkSums u v)
    (by
      intro w hw
      have hwEdges := (Finset.mem_filter.mp hw).2
      apply Finset.mem_product.mpr
      refine ⟨?_, Finset.mem_product.mpr ⟨?_, ?_⟩⟩
      · exact Finset.mem_image.mpr ⟨(u, w.2), hwEdges.1, rfl⟩
      · exact Finset.mem_image.mpr ⟨(w.1, w.2), hwEdges.2.1, rfl⟩
      · exact Finset.mem_image.mpr ⟨(w.1, v), hwEdges.2.2, rfl⟩)
    (by
      intro w hw w' hw' heq
      exact hinj w hw w' hw' heq)
  calc
    (threeEdgeWalks A' B E u v).card ≤ (C ×ˢ (C ×ˢ C)).card := hcard
    _ = (retainedGraphSumSet E).card ^ 3 := by
      simp [C, Finset.card_product]
      ring

/-- Candidate middle vertices adjacent to `v` and not forming a bad pair with `u`. -/
noncomputable def goodWalkMiddleVertices {G : Type*} [DecidableEq G]
    (X A' B : Finset G) (E : Finset (G × G)) (τ : ℝ) (u v : G) : Finset G :=
  (leftNeighborhood A' E v).filter fun u₁ =>
    (u, u₁) ∉ badLeftPairs X B E τ

/-- The number of middle vertices adjacent to `v` that are not bad partners of `u`.
The bad-partner incidence bound is measured in the larger selected neighborhood `U`. -/
theorem card_goodWalkMiddleVertices_ge {G : Type*} [DecidableEq G]
    (X U A' B : Finset G) (E : Finset (G × G)) (τ θ : ℝ) (b u v : G)
    (hθ : 0 < θ) (hA'sub : A' ⊆ U)
    (hA'large : (U.card : ℝ) / 2 ≤ (A'.card : ℝ))
    (hUadj : ∀ a ∈ U, (a, b) ∈ E)
    (hu : u ∈ A')
    (hvDegree : θ * (A'.card : ℝ) / 4 ≤
      (leftNeighborhood A' E v).card)
    (hbad : (leftDegree (badPairsAtRightVertex X B E τ b) u : ℝ) ≤
      θ * (U.card : ℝ) / 16) :
    θ * (U.card : ℝ) / 16 ≤
      (goodWalkMiddleVertices X A' B E τ u v).card := by
  classical
  let Bad := badLeftPairs X B E τ
  let BadAtB := badPairsAtRightVertex X B E τ b
  let N := leftNeighborhood A' E v
  let P := U.filter fun u₁ => (u, u₁) ∈ Bad
  let Q := BadAtB.filter fun p => p.1 = u
  have huU : u ∈ U := hA'sub hu
  have hPtoQ : P.card ≤ Q.card := by
    apply Finset.card_le_card_of_injOn (s := P) (t := Q) (fun u₁ => (u, u₁))
    · intro u₁ hu₁
      have hu₁' := Finset.mem_filter.mp hu₁
      apply Finset.mem_filter.mpr
      constructor
      · dsimp [Q, BadAtB]
        apply Finset.mem_filter.mpr
        refine ⟨?_, ?_⟩
        · exact hu₁'.2
        · exact ⟨hUadj u huU, hUadj u₁ hu₁'.1⟩
      · rfl
    · intro u₁ hu₁ u₂ hu₂ heq
      exact congrArg Prod.snd heq
  have hQcard : (Q.card : ℝ) =
      (leftDegree (badPairsAtRightVertex X B E τ b) u : ℝ) := by
    simp [Q, leftDegree, BadAtB]
  have hPbound : (P.card : ℝ) ≤ θ * (U.card : ℝ) / 16 := by
    have hPtoQreal : (P.card : ℝ) ≤ (Q.card : ℝ) := by exact_mod_cast hPtoQ
    rw [hQcard] at hPtoQreal
    exact le_trans hPtoQreal hbad
  have hNlarge : θ * (U.card : ℝ) / 8 ≤ (N.card : ℝ) := by
    dsimp [N]
    nlinarith [hvDegree, hA'large, hθ]
  have hbadNsub : N.filter (fun u₁ => (u, u₁) ∈ Bad) ⊆ P := by
    intro u₁ hu₁
    have hu₁' := Finset.mem_filter.mp hu₁
    have hu₁A' : u₁ ∈ A' := (Finset.filter_subset _ _) hu₁'.1
    exact Finset.mem_filter.mpr ⟨hA'sub hu₁A', hu₁'.2⟩
  have hbadNle :
      ((N.filter fun u₁ => (u, u₁) ∈ Bad).card : ℝ) ≤ (P.card : ℝ) := by
    exact_mod_cast Finset.card_le_card hbadNsub
  have hpartitionNat := Finset.card_filter_add_card_filter_not (s := N)
    (fun u₁ => (u, u₁) ∈ Bad)
  have hpartition :
      (goodWalkMiddleVertices X A' B E τ u v).card +
        (N.filter fun u₁ => (u, u₁) ∈ Bad).card = N.card := by
    simpa [goodWalkMiddleVertices, N, Bad, add_comm] using hpartitionNat
  have hpartitionReal :
      (goodWalkMiddleVertices X A' B E τ u v).card +
        ((N.filter fun u₁ => (u, u₁) ∈ Bad).card : ℝ) = (N.card : ℝ) := by
    exact_mod_cast hpartition
  nlinarith [hNlarge, hbadNle, hPbound]

/-- For fixed endpoints `u,v`, the good middle vertices contribute at least `τ |B|` walks
each. The walk set records `(u₁,v₁)` and remains a subset of the original edge set's paths. -/
theorem card_threeEdgeWalks_ge {G : Type*} [DecidableEq G]
    (X U A' B : Finset G) (E : Finset (G × G)) (τ θ : ℝ) (b u v : G)
    (hτ : 0 ≤ τ) (hθ : 0 < θ) (hA'sub : A' ⊆ U) (hUsubX : U ⊆ X)
    (hA'large : (U.card : ℝ) / 2 ≤ (A'.card : ℝ))
    (hUadj : ∀ a ∈ U, (a, b) ∈ E)
    (hu : u ∈ A')
    (hvDegree : θ * (A'.card : ℝ) / 4 ≤
      (leftNeighborhood A' E v).card)
    (hbad : (leftDegree (badPairsAtRightVertex X B E τ b) u : ℝ) ≤
      θ * (U.card : ℝ) / 16) :
    τ * (B.card : ℝ) * (θ * (U.card : ℝ) / 16) ≤
      (threeEdgeWalks A' B E u v).card := by
  classical
  let Good := goodWalkMiddleVertices X A' B E τ u v
  let C := (Good ×ˢ B).filter fun w =>
    (u, w.2) ∈ E ∧ (w.1, w.2) ∈ E
  have huU : u ∈ U := hA'sub hu
  have hGoodLower := card_goodWalkMiddleVertices_ge X U A' B E τ θ b u v
    hθ hA'sub hA'large hUadj hu hvDegree hbad
  have hcommonLower : ∀ u₁ ∈ Good,
      τ * (B.card : ℝ) ≤ (commonRightNeighbors B E u u₁).card := by
    intro u₁ hu₁
    change u₁ ∈ (leftNeighborhood A' E v).filter
      (fun u₁ => (u, u₁) ∉ badLeftPairs X B E τ) at hu₁
    rcases Finset.mem_filter.mp hu₁ with ⟨hu₁N, hnotbad⟩
    have hu₁A' : u₁ ∈ A' := (Finset.filter_subset _ _) hu₁N
    have hu₁U : u₁ ∈ U := hA'sub hu₁A'
    by_contra hnotle
    have hlt : (commonRightNeighbors B E u u₁).card < τ * (B.card : ℝ) :=
      lt_of_not_ge hnotle
    apply hnotbad
    simp [badLeftPairs, hUsubX huU, hUsubX hu₁U, hlt]
  have hsumNat := Finset.sum_card_fiberwise_eq_card_filter C Good Prod.fst
  have hsumCommon :
      (∑ u₁ ∈ Good, (commonRightNeighbors B E u u₁).card) = C.card := by
    calc
      (∑ u₁ ∈ Good, (commonRightNeighbors B E u u₁).card) =
          ∑ u₁ ∈ Good, (C.filter fun w => w.1 = u₁).card := by
            apply Finset.sum_congr rfl
            intro u₁ hu₁
            symm
            apply Finset.card_bij (s := C.filter fun w => w.1 = u₁)
              (t := commonRightNeighbors B E u u₁) (fun w _ => w.2)
            · intro w hw
              rcases Finset.mem_filter.mp hw with ⟨hwC, hfst⟩
              rcases Finset.mem_filter.mp hwC with ⟨hwprod, hedges⟩
              rcases Finset.mem_product.mp hwprod with ⟨_, hwB⟩
              rw [hfst] at hedges
              exact Finset.mem_filter.mpr ⟨hwB, hedges.1, hedges.2⟩
            · intro w hw w' hw' hsnd
              have hfst := (Finset.mem_filter.mp hw).2
              have hfst' := (Finset.mem_filter.mp hw').2
              exact Prod.ext (hfst.trans hfst'.symm) hsnd
            · intro w hw
              rcases Finset.mem_filter.mp hw with ⟨hwB, huv, hu₁v⟩
              refine ⟨(u₁, w), ?_, rfl⟩
              apply Finset.mem_filter.mpr
              constructor
              · apply Finset.mem_filter.mpr
                exact ⟨Finset.mem_product.mpr ⟨hu₁, hwB⟩, ⟨huv, hu₁v⟩⟩
              · rfl
      _ = (C.filter fun w => w.1 ∈ Good).card := hsumNat
      _ = C.card := by
        have hfilter : C.filter (fun w => w.1 ∈ Good) = C := by
          ext w
          simp only [Finset.mem_filter]
          constructor
          · exact And.left
          · intro hw
            rcases Finset.mem_filter.mp hw with ⟨hwprod, _⟩
            exact ⟨hw, (Finset.mem_product.mp hwprod).1⟩
        rw [hfilter]
  have hCsubset : C ⊆ threeEdgeWalks A' B E u v := by
    intro w hw
    have hw' := Finset.mem_filter.mp hw
    have hwAB := Finset.mem_product.mp hw'.1
    have hwGood : w.1 ∈ Good := hwAB.1
    change w.1 ∈ (leftNeighborhood A' E v).filter
      (fun u₁ => (u, u₁) ∉ badLeftPairs X B E τ) at hwGood
    have hwN : w.1 ∈ leftNeighborhood A' E v := (Finset.mem_filter.mp hwGood).1
    exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨
      (Finset.filter_subset _ _) hwN, hwAB.2⟩,
      hw'.2.1, hw'.2.2, (Finset.mem_filter.mp hwN).2⟩
  have hsumLower :
      τ * (B.card : ℝ) * (θ * (U.card : ℝ) / 16) ≤ (C.card : ℝ) := by
    calc
      τ * (B.card : ℝ) * (θ * (U.card : ℝ) / 16) ≤
          τ * (B.card : ℝ) * (Good.card : ℝ) :=
        mul_le_mul_of_nonneg_left hGoodLower (by positivity)
      _ = ∑ u₁ ∈ Good, τ * (B.card : ℝ) := by simp; ring
      _ ≤ ∑ u₁ ∈ Good, ((commonRightNeighbors B E u u₁).card : ℝ) := by
        apply Finset.sum_le_sum
        intro u₁ hu₁
        exact hcommonLower u₁ hu₁
      _ = (C.card : ℝ) := by
        exact_mod_cast hsumCommon
  have hCle : (C.card : ℝ) ≤ (threeEdgeWalks A' B E u v).card := by
    exact_mod_cast Finset.card_le_card hCsubset
  exact le_trans hsumLower hCle

/-- The score used in the manuscript's simultaneous neighborhood-size and bad-pair selection. -/
noncomputable def neighborhoodBadPairScore {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ : ℝ) (b : G) : ℝ :=
  ((leftNeighborhood A E b).card : ℝ) ^ 2 -
    (32 / θ) * (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card

/-- Finite Fubini for incidence counts between two finite sets. This is the double-counting
identity used below; it is proved by commuting the two finite sums. -/
theorem sum_filter_card_comm {α β : Type*} [DecidableEq α] [DecidableEq β]
    (S : Finset α) (T : Finset β) (R : α → β → Prop) [DecidableRel R] :
    (∑ b ∈ T, (S.filter fun a => R a b).card) =
      ∑ a ∈ S, (T.filter fun b => R a b).card := by
  classical
  simp_rw [Finset.card_eq_sum_ones, Finset.sum_filter]
  rw [Finset.sum_comm]

/-- The sum over right vertices of bad pairs present in their neighborhoods equals the total
number of bad-pair/common-neighbor incidences. -/
theorem sum_badLeftPairIncidences_eq {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (τ : ℝ) :
    (∑ b ∈ B,
      ((badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card) =
      ∑ p ∈ badLeftPairs A B E τ,
        (commonRightNeighbors B E p.1 p.2).card := by
  classical
  simpa [commonRightNeighbors] using
    (sum_filter_card_comm (badLeftPairs A B E τ) B
      (fun p b => (p.1, b) ∈ E ∧ (p.2, b) ∈ E))

/-- Each bad pair has fewer than `τ |B|` common neighbors, so the total bad-pair incidence
count is at most `τ |B| |A|²`. This bound is expressed as finite sums, with no probability
or Jensen principle hidden in the interface. -/
theorem sum_badLeftPairIncidences_le {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (τ : ℝ) (hτ : 0 ≤ τ) :
    (∑ b ∈ B,
      ((badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ) ≤
      τ * (B.card : ℝ) * (A.card : ℝ) ^ 2 := by
  classical
  let P := badLeftPairs A B E τ
  have hdouble :
      (∑ b ∈ B,
        ((P.filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ)) =
        ∑ p ∈ P, ((commonRightNeighbors B E p.1 p.2).card : ℝ) := by
    simpa [P, Nat.cast_sum] using
      congrArg (fun n : ℕ => (n : ℝ)) (sum_badLeftPairIncidences_eq A B E τ)
  have hsum :
    (∑ p ∈ P, ((commonRightNeighbors B E p.1 p.2).card : ℝ)) ≤
        (P.card : ℝ) * (τ * (B.card : ℝ)) := by
    calc
      (∑ p ∈ P, (commonRightNeighbors B E p.1 p.2).card : ℝ) ≤
          ∑ _p ∈ P, τ * (B.card : ℝ) := by
            apply Finset.sum_le_sum
            intro p hp
            have hbad : p ∈ badLeftPairs A B E τ := by simpa [P] using hp
            have hlt := (Finset.mem_filter.mp hbad).2
            exact_mod_cast hlt.le
      _ = (P.card : ℝ) * (τ * (B.card : ℝ)) := by simp
  have hPcard : P.card ≤ (A ×ˢ A).card := by
    dsimp [P, badLeftPairs]
    exact Finset.card_filter_le _ _
  have hPcardR : (P.card : ℝ) ≤ (A.card : ℝ) ^ 2 := by
    calc
      (P.card : ℝ) ≤ ((A ×ˢ A).card : ℝ) := by exact_mod_cast hPcard
      _ = (A.card : ℝ) ^ 2 := by simp [pow_two]
  calc
    (∑ b ∈ B,
      ((P.filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ)) =
        ∑ p ∈ P, ((commonRightNeighbors B E p.1 p.2).card : ℝ) := hdouble
    _ ≤
        (P.card : ℝ) * (τ * (B.card : ℝ)) := hsum
    _ ≤ (A.card : ℝ) ^ 2 * (τ * (B.card : ℝ)) :=
      mul_le_mul_of_nonneg_right hPcardR (by positivity)
    _ = τ * (B.card : ℝ) * (A.card : ℝ) ^ 2 := by ring

/-- Some right vertex has at most the average-threshold number of bad ordered pairs in its
left neighborhood. This is the finite averaging step needed to choose the set `U` in the
retained-edge BSG proof. -/
theorem exists_rightVertex_badPairs_le {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (τ : ℝ) (hτ : 0 ≤ τ)
    (hB : B.Nonempty) :
    ∃ b ∈ B,
      (((badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ) ≤
        τ * (A.card : ℝ) ^ 2 := by
  classical
  by_contra hnone
  have hevery : ∀ b ∈ B,
      τ * (A.card : ℝ) ^ 2 <
        (((badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ) := by
    intro b hb
    have hnotle : ¬
        (((badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ) ≤
          τ * (A.card : ℝ) ^ 2 := by
      intro hle
      exact hnone ⟨b, hb, hle⟩
    exact lt_of_not_ge hnotle
  have hstrict :
      ∑ b ∈ B, (τ * (A.card : ℝ) ^ 2) <
        ∑ b ∈ B,
          (((badLeftPairs A B E τ).filter fun p => (p.1, b) ∈ E ∧ (p.2, b) ∈ E).card : ℝ) := by
    apply Finset.sum_lt_sum
    · intro b hb
      exact (hevery b hb).le
    · obtain ⟨b, hb⟩ := hB
      exact ⟨b, hb, hevery b hb⟩
  have hbound := sum_badLeftPairIncidences_le A B E τ hτ
  have hconstant :
      (∑ b ∈ B, (τ * (A.card : ℝ) ^ 2)) =
        (B.card : ℝ) * (τ * (A.card : ℝ) ^ 2) := by simp
  rw [hconstant] at hstrict
  nlinarith [hbound]

/-- Vertices in `U` whose number of incident bad partners is at most the pruning threshold. -/
noncomputable def goodBadPartnerVertices {G : Type*} [DecidableEq G]
    (θ : ℝ) (U : Finset G) (Bad : Finset (G × G)) : Finset G :=
  U.filter fun u => (leftDegree Bad u : ℝ) ≤ θ * (U.card : ℝ) / 16

/-- If the total bad-pair incidence count is at most `θ |U|² / 32`, deleting vertices with
more than `θ |U| / 16` bad partners removes at most half of `U`. The threshold constants are
those used in the manuscript's retained-edge BSG argument. -/
theorem card_goodBadPartnerVertices_ge {G : Type*} [DecidableEq G]
    (θ : ℝ) (U : Finset G) (Bad : Finset (G × G))
    (hθ : 0 < θ) (hU : U.Nonempty)
    (hBad : (∑ u ∈ U, (leftDegree Bad u : ℝ)) ≤
      θ * (U.card : ℝ) ^ 2 / 32) :
    (U.card : ℝ) / 2 ≤ (goodBadPartnerVertices θ U Bad).card := by
  classical
  let p : G → Prop := fun u => (leftDegree Bad u : ℝ) ≤ θ * (U.card : ℝ) / 16
  let H : Finset G := U.filter fun u => θ * (U.card : ℝ) / 16 < (leftDegree Bad u : ℝ)
  have hH : H = U.filter fun u => ¬ p u := by
    ext u
    simp [H, p, not_le]
  have hparts := Finset.card_filter_add_card_filter_not (s := U) p
  have hpartsR :
      ((goodBadPartnerVertices θ U Bad).card : ℝ) + (H.card : ℝ) = (U.card : ℝ) := by
    have hparts' := congrArg (fun n : ℕ => (n : ℝ)) hparts
    simpa [goodBadPartnerVertices, p, H, hH, Nat.cast_add] using hparts'
  by_contra hnot
  have hsmallGood : (goodBadPartnerVertices θ U Bad).card < (U.card : ℝ) / 2 :=
    lt_of_not_ge hnot
  have hlargeH : (U.card : ℝ) / 2 < (H.card : ℝ) := by nlinarith [hpartsR]
  have hHnonempty : H.Nonempty := by
    apply Finset.card_pos.mp
    exact_mod_cast (by linarith : (0 : ℝ) < (H.card : ℝ))
  have hstrict :
      ∑ u ∈ H, (θ * (U.card : ℝ) / 16) <
        ∑ u ∈ H, (leftDegree Bad u : ℝ) := by
    apply Finset.sum_lt_sum
    · intro u hu
      change u ∈ U.filter (fun u => θ * (U.card : ℝ) / 16 < (leftDegree Bad u : ℝ)) at hu
      have huH : θ * (U.card : ℝ) / 16 < (leftDegree Bad u : ℝ) :=
        (Finset.mem_filter.mp hu).2
      exact huH.le
    · obtain ⟨u, hu⟩ := hHnonempty
      change u ∈ U.filter (fun u => θ * (U.card : ℝ) / 16 < (leftDegree Bad u : ℝ)) at hu
      have huH : θ * (U.card : ℝ) / 16 < (leftDegree Bad u : ℝ) :=
        (Finset.mem_filter.mp hu).2
      exact ⟨u, hu, huH⟩
  have hconst :
      (∑ u ∈ H, (θ * (U.card : ℝ) / 16)) =
        (H.card : ℝ) * (θ * (U.card : ℝ) / 16) := by simp
  rw [hconst] at hstrict
  have hsplit := Finset.sum_filter_add_sum_filter_not U p
    (fun u => (leftDegree Bad u : ℝ))
  have htotal :
      (∑ u ∈ U, (leftDegree Bad u : ℝ)) =
        (∑ u ∈ U.filter p, (leftDegree Bad u : ℝ)) +
          (∑ u ∈ H, (leftDegree Bad u : ℝ)) := by
    rw [hH]
    exact hsplit.symm
  have hgoodNonneg : 0 ≤ ∑ u ∈ U.filter p, (leftDegree Bad u : ℝ) := by
    apply Finset.sum_nonneg
    intro u hu
    exact Nat.cast_nonneg _
  have hx : 0 < θ * (U.card : ℝ) / 16 := by
    have hUpos : 0 < (U.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hU
    positivity
  have hscale :
      ((U.card : ℝ) / 2) * (θ * (U.card : ℝ) / 16) =
        θ * (U.card : ℝ) ^ 2 / 32 := by ring
  have hlargeTotal : θ * (U.card : ℝ) ^ 2 / 32 <
      (∑ u ∈ U, (leftDegree Bad u : ℝ)) := by
    calc
      θ * (U.card : ℝ) ^ 2 / 32 =
          ((U.card : ℝ) / 2) * (θ * (U.card : ℝ) / 16) := hscale.symm
      _ < (H.card : ℝ) * (θ * (U.card : ℝ) / 16) :=
        (mul_lt_mul_of_pos_right hlargeH hx)
      _ < ∑ u ∈ H, (leftDegree Bad u : ℝ) := hstrict
      _ ≤ ∑ u ∈ U, (leftDegree Bad u : ℝ) := by
        rw [htotal]
        linarith [hgoodNonneg]
  linarith

/-- Vertices whose degree is at least half the expected degree at density `θ`. -/
noncomputable def largeLeftDegreeVertices {G : Type*} [DecidableEq G]
    (θ : ℝ) (A B : Finset G) (E : Finset (G × G)) : Finset G :=
  A.filter fun a => θ * (B.card : ℝ) / 2 ≤ (leftDegree E a : ℝ)

/-- Handshake identity for a bipartite edge set contained in `A × B`. -/
theorem sum_leftDegree_eq_card {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G))
    (hE : E ⊆ A ×ˢ B) :
    (∑ a ∈ A, leftDegree E a) = E.card := by
  classical
  have hmaps : (E : Set (G × G)).MapsTo Prod.fst A := by
    intro e he
    have heE : e ∈ E := he
    exact (Finset.mem_product.mp (hE heE)).1
  simpa [leftDegree] using
    (Finset.card_eq_sum_card_fiberwise (f := Prod.fst) (s := E) (t := A) hmaps).symm

/-- Summing neighborhood sizes over right vertices counts every original edge once. -/
theorem sum_leftNeighborhood_card_eq_card {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B) :
    (∑ b ∈ B, (leftNeighborhood A E b).card) = E.card := by
  classical
  have hdouble := sum_filter_card_comm A B (fun a b => (a, b) ∈ E)
  have hdegree := sum_leftDegree_eq_card A B E hE
  calc
    (∑ b ∈ B, (leftNeighborhood A E b).card) =
        ∑ a ∈ A, (B.filter fun b => (a, b) ∈ E).card := by
          simpa [leftNeighborhood] using hdouble
    _ = ∑ a ∈ A, leftDegree E a := by
          apply Finset.sum_congr rfl
          intro a ha
          exact (leftDegree_eq_neighborCard A B E hE a).symm
    _ = E.card := hdegree

/-- The right-degree count is the size of the corresponding second-coordinate fiber of the
original edge set after restricting to `A'`. -/
theorem rightDegreeOnLeft_eq_fiberCard {G : Type*} [DecidableEq G]
    (A' : Finset G) (E : Finset (G × G)) (b : G) :
    rightDegreeOnLeft A' E b =
      ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 = b).card := by
  classical
  apply Finset.card_bij (s := leftNeighborhood A' E b)
    (t := (E.filter fun e => e.1 ∈ A').filter fun e => e.2 = b)
    (fun a _ => (a, b))
  · intro a ha
    have ha' := Finset.mem_filter.mp ha
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_filter.mpr ⟨ha'.2, ha'.1⟩, rfl⟩
  · intro a ha a' ha' heq
    exact congrArg Prod.fst heq
  · intro e he
    have he' := Finset.mem_filter.mp he
    have heA := Finset.mem_filter.mp he'.1
    have heb := he'.2
    refine ⟨e.1, ?_, ?_⟩
    · exact Finset.mem_filter.mpr ⟨heA.2, by
        have hpair : (e.1, b) = e := Prod.ext rfl heb.symm
        exact hpair ▸ heA.1⟩
    · exact Prod.ext_iff.mpr ⟨rfl, heb.symm⟩

/-- Summing right degrees over `B'` counts exactly the original edges induced by `A' × B'`. -/
theorem sum_rightDegreeOnLeft_eq_inducedEdges {G : Type*} [DecidableEq G]
    (A' B' : Finset G) (E : Finset (G × G)) :
    (∑ b ∈ B', rightDegreeOnLeft A' E b) =
      ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 ∈ B').card := by
  classical
  have hfib := Finset.sum_card_fiberwise_eq_card_filter
    (E.filter fun e => e.1 ∈ A') B' Prod.snd
  calc
    (∑ b ∈ B', rightDegreeOnLeft A' E b) =
        ∑ b ∈ B', ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 = b).card := by
          apply Finset.sum_congr rfl
          intro b hb
          exact rightDegreeOnLeft_eq_fiberCard A' E b
    _ = ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 ∈ B').card := hfib

/-- Summing right degrees over `B` counts all original edges incident to `A'`, when `E` is
contained in `A × B`. -/
theorem sum_rightDegreeOnLeft_eq_card_filter {G : Type*} [DecidableEq G]
    (A A' B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B) :
    (∑ b ∈ B, rightDegreeOnLeft A' E b) =
      (E.filter fun e => e.1 ∈ A').card := by
  classical
  have hsum := sum_rightDegreeOnLeft_eq_inducedEdges A' B E
  have hsecond : ∀ e ∈ E, e.2 ∈ B := fun e he =>
    (Finset.mem_product.mp (hE he)).2
  have hfilter :
      ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 ∈ B) =
        E.filter fun e => e.1 ∈ A' := by
    ext e
    simp only [Finset.mem_filter]
    constructor
    · intro h
      exact ⟨h.1.1, h.1.2⟩
    · intro h
      exact ⟨h, hsecond e h.1⟩
  rw [hfilter] at hsum
  exact hsum

/-- Thresholding the right degrees of `A'` retains many edges of the original graph and many
right vertices. The edge conclusion is expressed by filtering `E` itself. -/
theorem goodRightVertices_retain_edges {G : Type*} [DecidableEq G]
    (A A' B : Finset G) (E : Finset (G × G)) (θ : ℝ)
    (hθ : 0 < θ) (hA' : A'.Nonempty)
    (hE : E ⊆ A ×ˢ B)
    (hdeg : ∀ a ∈ A', θ * (B.card : ℝ) / 2 ≤ (leftDegree E a : ℝ)) :
    θ * (A'.card : ℝ) * (B.card : ℝ) / 4 ≤
        ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ goodRightVertices θ A' B E).card : ℝ) ∧
      θ * (B.card : ℝ) / 4 ≤ (goodRightVertices θ A' B E).card := by
  classical
  let p : G → Prop := fun b =>
    θ * (A'.card : ℝ) / 4 ≤ (rightDegreeOnLeft A' E b : ℝ)
  let B' := goodRightVertices θ A' B E
  let H := B.filter fun b => ¬ p b
  have hdegreeFilterNat :
      (∑ a ∈ A', leftDegree E a) = (E.filter fun e => e.1 ∈ A').card := by
    simpa [leftDegree] using
      (Finset.sum_card_fiberwise_eq_card_filter E A' Prod.fst)
  have hdegreeFilter :
      (∑ a ∈ A', (leftDegree E a : ℝ)) =
        ((E.filter fun e => e.1 ∈ A').card : ℝ) := by
    exact_mod_cast hdegreeFilterNat
  have htotal :
      (∑ b ∈ B, (rightDegreeOnLeft A' E b : ℝ)) =
        ((E.filter fun e => e.1 ∈ A').card : ℝ) := by
    exact_mod_cast sum_rightDegreeOnLeft_eq_card_filter A A' B E hE
  have htotalLower :
      θ * (A'.card : ℝ) * (B.card : ℝ) / 2 ≤
        (∑ b ∈ B, (rightDegreeOnLeft A' E b : ℝ)) := by
    rw [htotal, ← hdegreeFilter]
    calc
      θ * (A'.card : ℝ) * (B.card : ℝ) / 2 =
          ∑ _a ∈ A', (θ * (B.card : ℝ) / 2) := by simp; ring
      _ ≤ ∑ a ∈ A', (leftDegree E a : ℝ) := by
          apply Finset.sum_le_sum
          intro a ha
          exact hdeg a ha
  have hsplit := Finset.sum_filter_add_sum_filter_not B p
    (fun b => (rightDegreeOnLeft A' E b : ℝ))
  have hbadUpper :
      (∑ b ∈ H, (rightDegreeOnLeft A' E b : ℝ)) ≤
        θ * (A'.card : ℝ) * (B.card : ℝ) / 4 := by
    calc
      (∑ b ∈ H, (rightDegreeOnLeft A' E b : ℝ)) ≤
          ∑ _b ∈ H, (θ * (A'.card : ℝ) / 4) := by
            apply Finset.sum_le_sum
            intro b hb
            have hbnot : ¬ p b := (Finset.mem_filter.mp hb).2
            exact (lt_of_not_ge hbnot).le
      _ = (H.card : ℝ) * (θ * (A'.card : ℝ) / 4) := by simp
      _ ≤ (B.card : ℝ) * (θ * (A'.card : ℝ) / 4) := by
            apply mul_le_mul_of_nonneg_right _ (by positivity)
            exact_mod_cast Finset.card_filter_le B (fun b => ¬ p b)
      _ = θ * (A'.card : ℝ) * (B.card : ℝ) / 4 := by ring
  have hgoodLower :
      θ * (A'.card : ℝ) * (B.card : ℝ) / 4 ≤
        (∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ)) := by
    have hdecomp :
        (∑ b ∈ B, (rightDegreeOnLeft A' E b : ℝ)) =
          (∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ)) +
            (∑ b ∈ H, (rightDegreeOnLeft A' E b : ℝ)) := by
      simpa [B', goodRightVertices, p, H] using hsplit.symm
    rw [hdecomp] at htotalLower
    nlinarith [htotalLower, hbadUpper]
  have hgoodIsEdgeCount :
      (∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ)) =
        ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 ∈ B').card := by
    exact_mod_cast sum_rightDegreeOnLeft_eq_inducedEdges A' B' E
  have hsumUpper :
      (∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ)) ≤
        (B'.card : ℝ) * (A'.card : ℝ) := by
    calc
      (∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ)) ≤
          ∑ _b ∈ B', (A'.card : ℝ) := by
            apply Finset.sum_le_sum
            intro b hb
            exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)
      _ = (B'.card : ℝ) * (A'.card : ℝ) := by simp
  have hA'pos : 0 < (A'.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA'
  have hB'lower : θ * (B.card : ℝ) / 4 ≤ (B'.card : ℝ) := by
    apply le_of_mul_le_mul_right ?_ hA'pos
    calc
      (θ * (B.card : ℝ) / 4) * (A'.card : ℝ) =
          θ * (A'.card : ℝ) * (B.card : ℝ) / 4 := by ring
      _ ≤ ∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ) := hgoodLower
      _ ≤ (B'.card : ℝ) * (A'.card : ℝ) := hsumUpper
  refine ⟨?_, ?_⟩
  · have hfilters :
        ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 ∈ B') =
          E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ goodRightVertices θ A' B E := by
      ext e
      simp [B', goodRightVertices, and_assoc]
    calc
      θ * (A'.card : ℝ) * (B.card : ℝ) / 4 ≤
          ∑ b ∈ B', (rightDegreeOnLeft A' E b : ℝ) := hgoodLower
      _ = ((E.filter fun e => e.1 ∈ A').filter fun e => e.2 ∈ B').card := hgoodIsEdgeCount
      _ = ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ goodRightVertices θ A' B E).card : ℝ) := by
        rw [hfilters]
  · exact hB'lower

/-- Simultaneously choose a right vertex with a large squared neighborhood and few bad pairs.
The first moment is the retained-edge count, the second moment uses the fixed Mathlib finite
Cauchy--Schwarz inequality, and bad pairs are controlled by the incidence bound above. -/
theorem exists_rightVertex_joint_neighborhood_score {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ N : ℝ)
    (hθ : 0 < θ) (hB : B.Nonempty) (hE : E ⊆ A ×ˢ B)
    (hAsize : (A.card : ℝ) ≤ N)
    (hdense : θ * N * (B.card : ℝ) / 2 ≤ (E.card : ℝ)) :
    ∃ b ∈ B,
      3 * θ ^ 2 * N ^ 2 / 16 ≤
        neighborhoodBadPairScore A B E θ b := by
  classical
  let X : G → ℝ := fun b => (leftNeighborhood A E b).card
  let Y : G → ℝ := fun b => (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card
  have hXsumNat := sum_leftNeighborhood_card_eq_card A B E hE
  have hXsum : (∑ b ∈ B, X b) = (E.card : ℝ) := by
    simpa [X, Nat.cast_sum] using congrArg (fun n : ℕ => (n : ℝ)) hXsumNat
  have hXlower : θ * N * (B.card : ℝ) / 2 ≤ ∑ b ∈ B, X b := by
    rw [hXsum]
    exact hdense
  have hNnonneg : 0 ≤ N := le_trans (by positivity) hAsize
  have hAsquare : (A.card : ℝ) ^ 2 ≤ N ^ 2 :=
    (sq_le_sq₀ (by positivity) hNnonneg).2 hAsize
  have hYincidence := sum_badLeftPairIncidences_le A B E (θ ^ 3 / 512) (by positivity)
  have hYupper : (∑ b ∈ B, Y b) ≤
      (θ ^ 3 / 512) * (B.card : ℝ) * N ^ 2 := by
    simpa [Y, badPairsAtRightVertex] using
      hYincidence.trans (mul_le_mul_of_nonneg_left hAsquare (by positivity))
  have hXnonneg : 0 ≤ ∑ b ∈ B, X b := by
    apply Finset.sum_nonneg
    intro b hb
    exact Nat.cast_nonneg _
  have hBpos : 0 < (B.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hB
  have hCS : (∑ b ∈ B, X b) ^ 2 ≤
      (∑ b ∈ B, X b ^ 2) * (B.card : ℝ) := by
    have h := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul B
      (r := X) (f := fun b => X b ^ 2) (g := fun _ => (1 : ℝ))
      (by intro b hb; positivity)
      (by intro b hb; norm_num)
      (by intro b hb; simp)
    simpa using h
  have hbaseNonneg : 0 ≤ θ * N * (B.card : ℝ) / 2 := by positivity
  have hsumSquare :
      (θ * N * (B.card : ℝ) / 2) ^ 2 ≤ (∑ b ∈ B, X b) ^ 2 :=
    (sq_le_sq₀ hbaseNonneg hXnonneg).2 hXlower
  have hprod :
      (θ ^ 2 * N ^ 2 * (B.card : ℝ) / 4) * (B.card : ℝ) ≤
        (∑ b ∈ B, X b ^ 2) * (B.card : ℝ) := by
    calc
      (θ ^ 2 * N ^ 2 * (B.card : ℝ) / 4) * (B.card : ℝ) =
          (θ * N * (B.card : ℝ) / 2) ^ 2 := by ring
      _ ≤ (∑ b ∈ B, X b) ^ 2 := hsumSquare
      _ ≤ (∑ b ∈ B, X b ^ 2) * (B.card : ℝ) := hCS
  have hXsquareLower : θ ^ 2 * N ^ 2 * (B.card : ℝ) / 4 ≤
      ∑ b ∈ B, X b ^ 2 :=
    le_of_mul_le_mul_right hprod hBpos
  have hpenalty : (32 / θ) * (∑ b ∈ B, Y b) ≤
      θ ^ 2 * (B.card : ℝ) * N ^ 2 / 16 := by
    calc
      (32 / θ) * (∑ b ∈ B, Y b) ≤
          (32 / θ) * ((θ ^ 3 / 512) * (B.card : ℝ) * N ^ 2) :=
        mul_le_mul_of_nonneg_left hYupper (by positivity)
      _ = θ ^ 2 * (B.card : ℝ) * N ^ 2 / 16 := by
        field_simp [ne_of_gt hθ]
        ring
  have hscoreSum :
      3 * θ ^ 2 * N ^ 2 * (B.card : ℝ) / 16 ≤
        ∑ b ∈ B, neighborhoodBadPairScore A B E θ b := by
    have hident :
        (∑ b ∈ B, neighborhoodBadPairScore A B E θ b) =
          (∑ b ∈ B, X b ^ 2) - (32 / θ) * (∑ b ∈ B, Y b) := by
      simp [neighborhoodBadPairScore, X, Y, Finset.sum_sub_distrib, ← Finset.mul_sum]
    rw [hident]
    nlinarith [hXsquareLower, hpenalty]
  by_contra hnone
  have hbelow : ∀ b ∈ B,
      neighborhoodBadPairScore A B E θ b < 3 * θ ^ 2 * N ^ 2 / 16 := by
    intro b hb
    have hn : ¬ 3 * θ ^ 2 * N ^ 2 / 16 ≤
        neighborhoodBadPairScore A B E θ b := by
      intro hscore
      exact hnone ⟨b, hb, hscore⟩
    exact lt_of_not_ge hn
  have hstrict :
      ∑ b ∈ B, neighborhoodBadPairScore A B E θ b <
        ∑ _b ∈ B, (3 * θ ^ 2 * N ^ 2 / 16) := by
    apply Finset.sum_lt_sum
    · intro b hb
      exact (hbelow b hb).le
    · obtain ⟨b, hb⟩ := hB
      exact ⟨b, hb, hbelow b hb⟩
  have hconstant :
      (∑ _b ∈ B, (3 * θ ^ 2 * N ^ 2 / 16)) =
        (B.card : ℝ) * (3 * θ ^ 2 * N ^ 2 / 16) := by simp
  rw [hconstant] at hstrict
  nlinarith [hscoreSum]

/-- A convenient consequence of the joint score: the selected neighborhood has linear size and
its bad-pair density is at most `θ/32`. The size constant `1/4` is weaker than the manuscript's
`1/(2√2)` but suffices for all later absolute-constant conclusions. -/
theorem exists_rightVertex_neighborhood_bounds {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ N : ℝ)
    (hθ : 0 < θ) (hB : B.Nonempty)
    (hE : E ⊆ A ×ˢ B) (hAsize : (A.card : ℝ) ≤ N)
    (hdense : θ * N * (B.card : ℝ) / 2 ≤ (E.card : ℝ)) :
    ∃ b ∈ B,
      θ * N / 4 ≤ (leftNeighborhood A E b).card ∧
      (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card ≤
        θ * ((leftNeighborhood A E b).card : ℝ) ^ 2 / 32 := by
  obtain ⟨b, hb, hscore⟩ :=
    exists_rightVertex_joint_neighborhood_score A B E θ N hθ hB hE hAsize hdense
  have hNnonneg : 0 ≤ N := le_trans (by positivity) hAsize
  refine ⟨b, hb, ?_, ?_⟩
  · have hpenNonneg :
        0 ≤ (32 / θ) * (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card := by positivity
    have hx2 : (θ * N / 4) ^ 2 ≤
        ((leftNeighborhood A E b).card : ℝ) ^ 2 := by
      dsimp [neighborhoodBadPairScore] at hscore
      nlinarith [hscore, hpenNonneg]
    have hxNonneg : 0 ≤ ((leftNeighborhood A E b).card : ℝ) := by positivity
    have htargetNonneg : 0 ≤ θ * N / 4 := by positivity
    exact (sq_le_sq₀ htargetNonneg hxNonneg).1 hx2
  · have hpenLe :
        (32 / θ) * (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card ≤
          ((leftNeighborhood A E b).card : ℝ) ^ 2 := by
      dsimp [neighborhoodBadPairScore] at hscore
      nlinarith [hscore]
    calc
      (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card =
          (θ / 32) * ((32 / θ) *
            (badPairsAtRightVertex A B E (θ ^ 3 / 512) b).card) := by
              field_simp [ne_of_gt hθ]
      _ ≤ (θ / 32) * ((leftNeighborhood A E b).card : ℝ) ^ 2 :=
        mul_le_mul_of_nonneg_left hpenLe (by positivity)
      _ = θ * ((leftNeighborhood A E b).card : ℝ) ^ 2 / 32 := by ring

/-- Every bad pair counted at `b` has both endpoints in `b`'s left neighborhood. -/
theorem badPairsAtRightVertex_subset_neighborhood {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (τ : ℝ) (b : G) :
    badPairsAtRightVertex A B E τ b ⊆
      leftNeighborhood A E b ×ˢ leftNeighborhood A E b := by
  classical
  intro p hp
  have hp' := Finset.mem_filter.mp hp
  have hpA := Finset.mem_product.mp (Finset.mem_filter.mp hp'.1).1
  exact Finset.mem_product.mpr
    ⟨Finset.mem_filter.mpr ⟨hpA.1, hp'.2.1⟩,
      Finset.mem_filter.mpr ⟨hpA.2, hp'.2.2⟩⟩

/-- The joint neighborhood selection followed by bad-partner deletion produces the first
large endpoint set in the manuscript's graph BSG proof. -/
theorem exists_large_pruned_leftEndpointSet {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ N : ℝ)
    (hθ : 0 < θ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hE : E ⊆ A ×ˢ B)
    (hAsize : (A.card : ℝ) ≤ N)
    (hdeg : ∀ a ∈ A, θ * (B.card : ℝ) / 2 ≤ (leftDegree E a : ℝ))
    (hdense : θ * N * (B.card : ℝ) / 2 ≤ (E.card : ℝ)) :
    ∃ b ∈ B, ∃ A' : Finset G,
      A' ⊆ leftNeighborhood A E b ∧
      θ * N / 4 ≤ (leftNeighborhood A E b).card ∧
      (leftNeighborhood A E b).card / 2 ≤ (A'.card : ℝ) ∧
      θ * N / 8 ≤ (A'.card : ℝ) ∧
      (∀ a ∈ A', θ * (B.card : ℝ) / 2 ≤ (leftDegree E a : ℝ)) ∧
      ∀ a ∈ A',
        (leftDegree (badPairsAtRightVertex A B E (θ ^ 3 / 512) b) a : ℝ) ≤
          θ * ((leftNeighborhood A E b).card : ℝ) / 16 := by
  obtain ⟨b, hb, hUlarge, hBadCard⟩ :=
    exists_rightVertex_neighborhood_bounds A B E θ N hθ hB hE hAsize hdense
  let U := leftNeighborhood A E b
  let Bad := badPairsAtRightVertex A B E (θ ^ 3 / 512) b
  have hUpos : 0 < (U.card : ℝ) := by
    have hApos : 0 < (A.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hA
    nlinarith [hUlarge, hθ]
  have hUnonempty : U.Nonempty := by
    apply Finset.card_pos.mp
    exact_mod_cast hUpos
  have hBadSub : Bad ⊆ U ×ˢ U := by
    exact badPairsAtRightVertex_subset_neighborhood A B E (θ ^ 3 / 512) b
  have hBadCard' : (Bad.card : ℝ) ≤ θ * (U.card : ℝ) ^ 2 / 32 := by
    simpa [Bad, U] using hBadCard
  let A' := goodBadPartnerVertices θ U Bad
  have hBadSumNat := sum_leftDegree_eq_card U U Bad hBadSub
  have hBadSum : (∑ a ∈ U, (leftDegree Bad a : ℝ)) = (Bad.card : ℝ) := by
    exact_mod_cast hBadSumNat
  have hA'size := card_goodBadPartnerVertices_ge θ U Bad hθ hUnonempty
    (by rw [hBadSum]; exact hBadCard')
  refine ⟨b, hb, A', ?_, hUlarge, ?_, ?_, ?_, ?_⟩
  · exact Finset.filter_subset _ _
  · dsimp [U, A']
    exact hA'size
  · dsimp [A']
    calc
      θ * N / 8 = (θ * N / 4) / 2 := by ring
      _ ≤ (U.card : ℝ) / 2 := by nlinarith [hUlarge]
      _ ≤ (goodBadPartnerVertices θ U Bad).card := hA'size
  · intro a ha
    have ha' : a ∈ goodBadPartnerVertices θ U Bad := by simpa [A'] using ha
    have haU : a ∈ U := (Finset.mem_filter.mp ha').1
    have haA : a ∈ A := (Finset.mem_filter.mp haU).1
    exact hdeg a haA
  · intro a ha
    exact (Finset.mem_filter.mp ha).2

/-- Cardinality-form interface for bad-partner pruning. When `Bad` consists of ordered pairs
inside `U × U`, the handshake identity turns its cardinality bound into the incidence bound
used by `card_goodBadPartnerVertices_ge`. -/
theorem card_goodBadPartnerVertices_ge_of_card {G : Type*} [DecidableEq G]
    (θ : ℝ) (U : Finset G) (Bad : Finset (G × G))
    (hθ : 0 < θ) (hU : U.Nonempty) (hBadSub : Bad ⊆ U ×ˢ U)
    (hBadCard : (Bad.card : ℝ) ≤ θ * (U.card : ℝ) ^ 2 / 32) :
    (U.card : ℝ) / 2 ≤ (goodBadPartnerVertices θ U Bad).card := by
  classical
  have hsumNat := sum_leftDegree_eq_card U U Bad hBadSub
  have hsum : (∑ u ∈ U, (leftDegree Bad u : ℝ)) = (Bad.card : ℝ) := by
    exact_mod_cast hsumNat
  exact card_goodBadPartnerVertices_ge θ U Bad hθ hU (by rw [hsum]; exact hBadCard)

/-- Every left degree is bounded by the size of the right vertex set. -/
theorem leftDegree_le_card_right {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B) (a : G) :
    leftDegree E a ≤ B.card := by
  classical
  apply Finset.card_le_card_of_injOn Prod.snd
  · intro e he
    exact (Finset.mem_product.mp (hE (Finset.mem_filter.mp he).1)).2
  · intro e he e' he' hsnd
    have hfst : e.1 = e'.1 := by
      rw [(Finset.mem_filter.mp he).2, (Finset.mem_filter.mp he').2]
    exact Prod.ext hfst hsnd

/-- Removing left vertices below half the average-degree threshold retains at least half the
density lower bound in incident edges. The conclusion is stated as a degree sum, so the exact
original edge set remains visible for the later induced-edge argument. -/
theorem sum_largeLeftDegree_ge {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B)
    (θ : ℝ) (hθ : 0 ≤ θ)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    θ * (A.card : ℝ) * (B.card : ℝ) / 2 ≤
      ∑ a ∈ largeLeftDegreeVertices θ A B E, (leftDegree E a : ℝ) := by
  classical
  let p : G → Prop := fun a => θ * (B.card : ℝ) / 2 ≤ (leftDegree E a : ℝ)
  have htotalNat := sum_leftDegree_eq_card A B E hE
  have htotal : (∑ a ∈ A, (leftDegree E a : ℝ)) = (E.card : ℝ) := by
    exact_mod_cast htotalNat
  have hsplit := Finset.sum_filter_add_sum_filter_not A p (fun a => (leftDegree E a : ℝ))
  have hlow :
      (∑ a ∈ A.filter (fun a => ¬ p a), (leftDegree E a : ℝ)) ≤
        θ * (A.card : ℝ) * (B.card : ℝ) / 2 := by
    calc
      (∑ a ∈ A.filter (fun a => ¬ p a), (leftDegree E a : ℝ)) ≤
          ∑ _a ∈ A.filter (fun a => ¬ p a), θ * (B.card : ℝ) / 2 := by
            apply Finset.sum_le_sum
            intro a ha
            have hnot : ¬ p a := (Finset.mem_filter.mp ha).2
            exact (lt_of_not_ge hnot).le
      _ = ((A.filter (fun a => ¬ p a)).card : ℝ) * (θ * (B.card : ℝ) / 2) := by simp
      _ ≤ (A.card : ℝ) * (θ * (B.card : ℝ) / 2) := by
            apply mul_le_mul_of_nonneg_right _ (by positivity)
            exact_mod_cast Finset.card_filter_le A (fun a => ¬ p a)
      _ = θ * (A.card : ℝ) * (B.card : ℝ) / 2 := by ring
  rw [← hsplit] at htotal
  have hhigh : θ * (A.card : ℝ) * (B.card : ℝ) / 2 ≤
      ∑ a ∈ A.filter p, (leftDegree E a : ℝ) := by
    nlinarith
  simpa [largeLeftDegreeVertices, p] using hhigh

/-- The high-degree endpoint set from the standard first pruning step is large. -/
theorem card_largeLeftDegree_ge {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B)
    (θ : ℝ) (hθ : 0 ≤ θ) (hB : B.Nonempty)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    θ * (A.card : ℝ) / 2 ≤ (largeLeftDegreeVertices θ A B E).card := by
  classical
  have hsum := sum_largeLeftDegree_ge A B E hE θ hθ hdense
  have hsumUpper :
      (∑ a ∈ largeLeftDegreeVertices θ A B E, (leftDegree E a : ℝ)) ≤
        ((largeLeftDegreeVertices θ A B E).card : ℝ) * (B.card : ℝ) := by
    calc
      (∑ a ∈ largeLeftDegreeVertices θ A B E, (leftDegree E a : ℝ)) ≤
          ∑ _a ∈ largeLeftDegreeVertices θ A B E, (B.card : ℝ) := by
            apply Finset.sum_le_sum
            intro a ha
            exact_mod_cast leftDegree_le_card_right A B E hE a
      _ = ((largeLeftDegreeVertices θ A B E).card : ℝ) * (B.card : ℝ) := by simp
  have hBpos : 0 < (B.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hB
  nlinarith

/-- Counting the high-degree vertices retains at least half of the dense graph's original
edges. The edge filter is taken in `E` itself. -/
theorem card_edges_with_largeLeft_ge {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (hE : E ⊆ A ×ˢ B)
    (θ : ℝ) (hθ : 0 ≤ θ)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    θ * (A.card : ℝ) * (B.card : ℝ) / 2 ≤
      ((E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E).card : ℝ) := by
  classical
  calc
    θ * (A.card : ℝ) * (B.card : ℝ) / 2 ≤
        ∑ a ∈ largeLeftDegreeVertices θ A B E, (leftDegree E a : ℝ) :=
          sum_largeLeftDegree_ge A B E hE θ hθ hdense
    _ = ((E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E).card : ℝ) := by
      simpa only [leftDegree, Nat.cast_sum] using congrArg (fun n : ℕ => (n : ℝ))
        (Finset.sum_card_fiberwise_eq_card_filter E
          (largeLeftDegreeVertices θ A B E) Prod.fst)

/-- The initial low-degree cut, joint neighborhood selection, bad-partner deletion, and
right-degree thresholding together produce endpoint sets with retained edges of the original
graph, while retaining the selected neighborhood and pointwise bad-partner bound needed for
the subsequent three-walk count. -/
theorem exists_graphBSG_endpoint_witness {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ : ℝ)
    (hθ : 0 < θ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hE : E ⊆ A ×ˢ B)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    ∃ b ∈ B, ∃ U A' B' : Finset G,
      U = leftNeighborhood (largeLeftDegreeVertices θ A B E)
        (E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E) b ∧
      B' = goodRightVertices θ A' B
        (E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E) ∧
      θ * (A.card : ℝ) / 4 ≤ (U.card : ℝ) ∧
      (U.card : ℝ) / 2 ≤ (A'.card : ℝ) ∧
      A' ⊆ U ∧
      A' ⊆ A ∧ B' ⊆ B ∧
      θ * (A.card : ℝ) / 8 ≤ (A'.card : ℝ) ∧
      θ * (B.card : ℝ) / 4 ≤ (B'.card : ℝ) ∧
      θ ^ 2 * (A.card : ℝ) * (B.card : ℝ) / 32 ≤
        ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) ∧
      ∀ a ∈ A',
        (leftDegree
          (badPairsAtRightVertex (largeLeftDegreeVertices θ A B E) B
            (E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E)
            (θ ^ 3 / 512) b) a : ℝ) ≤ θ * (U.card : ℝ) / 16 := by
  classical
  let A₀ := largeLeftDegreeVertices θ A B E
  let E₀ := E.filter fun e => e.1 ∈ A₀
  have hA₀size := card_largeLeftDegree_ge A B E hE θ hθ.le hB hdense
  have hA₀sub : A₀ ⊆ A := by
    dsimp [A₀, largeLeftDegreeVertices]
    exact Finset.filter_subset _ _
  have hA₀nonempty : A₀.Nonempty := by
    apply Finset.card_pos.mp
    have hApositive : 0 < (A.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hA
    have hA₀positive : 0 < (A₀.card : ℝ) := by nlinarith [hA₀size, hθ]
    exact_mod_cast hA₀positive
  have hE₀ : E₀ ⊆ A₀ ×ˢ B := by
    intro e he
    have he' := Finset.mem_filter.mp he
    exact Finset.mem_product.mpr
      ⟨he'.2, (Finset.mem_product.mp (hE he'.1)).2⟩
  have hE₀size : (E₀.card : ℝ) ≤ (E.card : ℝ) := by
    exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)
  have hE₀dense : θ * (A.card : ℝ) * (B.card : ℝ) / 2 ≤ (E₀.card : ℝ) := by
    simpa [E₀, A₀] using card_edges_with_largeLeft_ge A B E hE θ hθ.le hdense
  have hA₀scale : (A₀.card : ℝ) ≤ (A.card : ℝ) := by
    exact_mod_cast Finset.card_le_card hA₀sub
  have hdeg₀ : ∀ a ∈ A₀, θ * (B.card : ℝ) / 2 ≤ (leftDegree E₀ a : ℝ) := by
    intro a ha
    have hmem : a ∈ largeLeftDegreeVertices θ A B E := by
      simpa [A₀] using ha
    have hhigh : θ * (B.card : ℝ) / 2 ≤ (leftDegree E a : ℝ) := by
      exact_mod_cast (Finset.mem_filter.mp hmem).2
    have hdegreeEq : leftDegree E₀ a = leftDegree E a := by
      unfold leftDegree E₀
      apply congrArg Finset.card
      ext e
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨⟨he, _⟩, heq⟩
        exact ⟨he, heq⟩
      · rintro ⟨he, heq⟩
        refine ⟨⟨he, ?_⟩, heq⟩
        rw [heq]
        exact ha
    rw [hdegreeEq]
    exact hhigh
  obtain ⟨b, hb, A', hA'neigh, hUlarge, hUhalf, hA'size, hA'deg, hA'bad⟩ :=
    exists_large_pruned_leftEndpointSet A₀ B E₀ θ (A.card : ℝ)
      hθ hA₀nonempty hB hE₀ hA₀scale hdeg₀ hE₀dense
  have hA'subA₀ : A' ⊆ A₀ := by
    intro a ha
    exact (Finset.mem_filter.mp (hA'neigh ha)).1
  have hA'subA : A' ⊆ A := hA'subA₀.trans hA₀sub
  have hA'positive : 0 < (A'.card : ℝ) := by
    have hApositive : 0 < (A.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hA
    nlinarith [hA'size, hθ, hApositive]
  have hA'nonempty : A'.Nonempty := by
    apply Finset.card_pos.mp
    exact_mod_cast hA'positive
  let B' := goodRightVertices θ A' B E₀
  have hB'facts := goodRightVertices_retain_edges A₀ A' B E₀ θ
    hθ hA'nonempty hE₀ hA'deg
  have hE₀edges :
      θ * (A'.card : ℝ) * (B.card : ℝ) / 4 ≤
        ((E₀.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) := by
    simpa [B', Finset.filter_filter, and_assoc] using hB'facts.1
  have hEfilter :
      E₀.filter (fun e => e.1 ∈ A' ∧ e.2 ∈ B') =
        E.filter (fun e => e.1 ∈ A' ∧ e.2 ∈ B') := by
    ext e
    simp only [E₀, Finset.mem_filter]
    constructor
    · rintro ⟨⟨he, ha₀⟩, ha'b⟩
      exact ⟨he, ha'b.1, ha'b.2⟩
    · rintro ⟨he, ha', hb'⟩
      exact ⟨⟨he, hA'subA₀ ha'⟩, ha', hb'⟩
  refine ⟨b, hb, leftNeighborhood A₀ E₀ b, A', B', rfl, rfl, hUlarge, hUhalf,
    ?_, hA'subA, ?_, hA'size, ?_, ?_, ?_⟩
  · simpa [A₀, E₀] using hA'neigh
  · exact Finset.filter_subset _ _
  · exact hB'facts.2
  · calc
      θ ^ 2 * (A.card : ℝ) * (B.card : ℝ) / 32 =
          (θ * (A.card : ℝ) / 8) * (θ * (B.card : ℝ) / 4) := by ring
      _ ≤ (A'.card : ℝ) * (θ * (B.card : ℝ) / 4) :=
        mul_le_mul_of_nonneg_right hA'size (by positivity)
      _ = θ * (A'.card : ℝ) * (B.card : ℝ) / 4 := by ring
      _ ≤ ((E₀.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) := hE₀edges
      _ = ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) := by rw [hEfilter]
  · intro a ha
    exact hA'bad a ha

/-- Forgetting the walk-specific witness gives the endpoint-size and original-edge conclusion. -/
theorem exists_graphBSG_endpoint_sets {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ : ℝ)
    (hθ : 0 < θ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hE : E ⊆ A ×ˢ B)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    ∃ A' B' : Finset G,
      A' ⊆ A ∧ B' ⊆ B ∧
      θ * (A.card : ℝ) / 8 ≤ (A'.card : ℝ) ∧
      θ * (B.card : ℝ) / 4 ≤ (B'.card : ℝ) ∧
      θ ^ 2 * (A.card : ℝ) * (B.card : ℝ) / 32 ≤
        ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) := by
  obtain ⟨b, hb, U, A', B', hU, hB'def, hUlarge, hA'large, hA'subU,
    hA'sub, hB'sub, hA'size, hB'size, hEdges, hbad⟩ :=
    exists_graphBSG_endpoint_witness A B E θ hθ hA hB hE hdense
  exact ⟨A', B', hA'sub, hB'sub, hA'size, hB'size, hEdges⟩

/- Fixed endpoint data implies the three-edge walk bound, with the large existential construction
   kept in a separate theorem to control elaboration. -/
theorem graphBSG_threeEdgeWalks_of_witness {G : Type*} [DecidableEq G]
    (A B A₀ U A' B' : Finset G) (E E₀ : Finset (G × G)) (θ : ℝ) (b : G)
    (hθ : 0 < θ)
    (hU : U = leftNeighborhood A₀ E₀ b)
    (hB'def : B' = goodRightVertices θ A' B E₀)
    (hE₀sub : E₀ ⊆ E)
    (hUlarge : θ * (A.card : ℝ) / 4 ≤ (U.card : ℝ))
    (hA'large : (U.card : ℝ) / 2 ≤ (A'.card : ℝ))
    (hA'subU : A' ⊆ U)
    (hbad : ∀ u ∈ A',
      (leftDegree (badPairsAtRightVertex A₀ B E₀ (θ ^ 3 / 512) b) u : ℝ) ≤
        θ * (U.card : ℝ) / 16) :
    ∀ u ∈ A', ∀ v ∈ B',
      θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) / 32768 ≤
        (threeEdgeWalks A' B E u v).card := by
  intro u hu v hv
  have hUsubA₀ : U ⊆ A₀ := by
    intro a ha
    rw [hU] at ha
    exact (Finset.mem_filter.mp ha).1
  have hUadj : ∀ a ∈ U, (a, b) ∈ E₀ := by
    intro a ha
    rw [hU] at ha
    exact (Finset.mem_filter.mp ha).2
  have hvGood : v ∈ goodRightVertices θ A' B E₀ := by
    rw [← hB'def]
    exact hv
  have hvDegree : θ * (A'.card : ℝ) / 4 ≤
      (leftNeighborhood A' E₀ v).card := by
    have hv' := (Finset.mem_filter.mp hvGood).2
    simpa [rightDegreeOnLeft] using hv'
  have hwalkInE₀ := card_threeEdgeWalks_ge A₀ U A' B E₀
    (θ ^ 3 / 512) θ b u v (by positivity) hθ hA'subU hUsubA₀ hA'large hUadj hu
      hvDegree (hbad u hu)
  have hwalkLower :
      θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) / 32768 ≤
        (threeEdgeWalks A' B E₀ u v).card := by
    calc
      θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) / 32768 =
          (θ ^ 4 * (B.card : ℝ) / 8192) * (θ * (A.card : ℝ) / 4) := by ring
      _ ≤ (θ ^ 4 * (B.card : ℝ) / 8192) * (U.card : ℝ) :=
        mul_le_mul_of_nonneg_left hUlarge (by positivity)
      _ = (θ ^ 3 / 512) * (B.card : ℝ) * (θ * (U.card : ℝ) / 16) := by ring
      _ ≤ (threeEdgeWalks A' B E₀ u v).card := hwalkInE₀
  have hE₀ : E₀ ⊆ E := by
    exact hE₀sub
  exact le_trans hwalkLower <| by
    exact_mod_cast Finset.card_le_card (threeEdgeWalks_mono A' B E₀ E u v hE₀)

/-- The joint endpoint-selection construction also supplies the data needed to establish
the three-edge walk lower bound for every pair in the selected endpoints. -/
theorem exists_graphBSG_walk_witness {G : Type*} [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ : ℝ)
    (hθ : 0 < θ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hE : E ⊆ A ×ˢ B)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    ∃ b ∈ B, ∃ U A' B' : Finset G,
      U = leftNeighborhood (largeLeftDegreeVertices θ A B E)
        (E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E) b ∧
      B' = goodRightVertices θ A' B
        (E.filter fun e => e.1 ∈ largeLeftDegreeVertices θ A B E) ∧
      θ * (A.card : ℝ) / 4 ≤ (U.card : ℝ) ∧
      (U.card : ℝ) / 2 ≤ (A'.card : ℝ) ∧
      A' ⊆ U ∧ A' ⊆ A ∧ B' ⊆ B ∧
      θ * (A.card : ℝ) / 8 ≤ (A'.card : ℝ) ∧
      θ * (B.card : ℝ) / 4 ≤ (B'.card : ℝ) ∧
      θ ^ 2 * (A.card : ℝ) * (B.card : ℝ) / 32 ≤
        ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) ∧
      ∀ u ∈ A', ∀ v ∈ B',
        θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) / 32768 ≤
          (threeEdgeWalks A' B E u v).card := by
  obtain ⟨b, hb, U, A', B', hU, hB'def, hUlarge, hA'large, hA'subU,
    hA'sub, hB'sub, hA'size, hB'size, hEdges, hbad⟩ :=
    exists_graphBSG_endpoint_witness A B E θ hθ hA hB hE hdense
  refine ⟨b, hb, U, A', B', hU, hB'def, hUlarge, hA'large, hA'subU,
    hA'sub, hB'sub, hA'size, hB'size, hEdges, ?_⟩
  let A₀ := largeLeftDegreeVertices θ A B E
  let E₀ := E.filter fun e => e.1 ∈ A₀
  have hE₀sub : E₀ ⊆ E := Finset.filter_subset _ _
  exact graphBSG_threeEdgeWalks_of_witness A B A₀ U A' B' E E₀ θ b hθ hU hB'def
    hE₀sub hUlarge hA'large hA'subU (by simpa [A₀, E₀] using hbad)

/-- The endpoint construction also gives the graph-BSG sumset bound with an explicit absolute
constant. The proof assigns one endpoint representation to each sum and counts its disjoint walk
codes inside `C³`. -/
theorem exists_graphBSG_sumset_witness {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A B : Finset G) (E : Finset (G × G)) (θ : ℝ)
    (hθ : 0 < θ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hE : E ⊆ A ×ˢ B)
    (hdense : θ * (A.card : ℝ) * (B.card : ℝ) ≤ (E.card : ℝ)) :
    ∃ A' B' : Finset G,
      A' ⊆ A ∧ B' ⊆ B ∧
      θ * (A.card : ℝ) / 8 ≤ (A'.card : ℝ) ∧
      θ * (B.card : ℝ) / 4 ≤ (B'.card : ℝ) ∧
      θ ^ 2 * (A.card : ℝ) * (B.card : ℝ) / 32 ≤
        ((E.filter fun e => e.1 ∈ A' ∧ e.2 ∈ B').card : ℝ) ∧
      (((A'.product B').image fun p => p.1 + p.2).card : ℝ) ≤
        32768 * ((retainedGraphSumSet E).card : ℝ) ^ 3 /
          (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ)) := by
  obtain ⟨_, _, _, A', B', _, _, _, _, _, hA'sub, hB'sub, hA'size, hB'size,
    hEdges, hwalk⟩ := exists_graphBSG_walk_witness A B E θ hθ hA hB hE hdense
  have hsumset := endpointSumSet_card_mul_le_sumset_cube A' B B' E
    (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) / 32768) (by
      intro s hs
      rcases Finset.mem_image.mp hs with ⟨p, hp, rfl⟩
      rcases Finset.mem_product.mp hp with ⟨hpA, hpB⟩
      exact ⟨p, hpA, hpB, rfl, hwalk p.1 hpA p.2 hpB⟩)
  have hdenom : 0 < θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) := by
    have hAc : 0 < (A.card : ℝ) := by
      exact_mod_cast hA.card_pos
    have hBc : 0 < (B.card : ℝ) := by
      exact_mod_cast hB.card_pos
    positivity
  have hmul :
      ((endpointSumSet A' B').card : ℝ) *
        (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ)) ≤
      32768 * (retainedGraphSumSet E).card ^ 3 := by
    have hscaled := mul_le_mul_of_nonneg_right hsumset
      (by norm_num : (0 : ℝ) ≤ 32768)
    calc
      ((endpointSumSet A' B').card : ℝ) *
          (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ)) =
        (((endpointSumSet A' B').card : ℝ) *
          (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ) / 32768)) * 32768 := by ring
      _ ≤ ((retainedGraphSumSet E).card : ℝ) ^ 3 * 32768 := by
        exact hscaled
      _ = 32768 * (retainedGraphSumSet E).card ^ 3 := by ring
  have hsumsetFinal :
      ((endpointSumSet A' B').card : ℝ) ≤
        32768 * ((retainedGraphSumSet E).card : ℝ) ^ 3 /
          (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ)) :=
    (le_div_iff₀ hdenom).2 hmul
  have hsumsetFinal' :
      (((A'.product B').image fun p => p.1 + p.2).card : ℝ) ≤
        32768 * ((retainedGraphSumSet E).card : ℝ) ^ 3 /
          (θ ^ 5 * (A.card : ℝ) * (B.card : ℝ)) := by
    simpa [endpointSumSet] using hsumsetFinal
  exact ⟨A', B', hA'sub, hB'sub, hA'size, hB'size, hEdges, hsumsetFinal'⟩

end Kakeya4.GraphBSG
