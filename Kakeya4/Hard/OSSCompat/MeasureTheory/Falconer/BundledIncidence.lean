    apply le_antisymm
    · simpa [F,g,hzero] using profileSuffixMinimum_le hgc
        (show (0:ℝ) ∈ Icc 0 1 by constructor <;> norm_num)
        (show (0:ℝ) ∈ Icc 0 1 by constructor <;> norm_num)
    · obtain ⟨z,hz,he,_⟩ := profileSuffixMinimum_attained hgc
        (show (0:ℝ) ∈ Icc 0 1 by constructor <;> norm_num)
