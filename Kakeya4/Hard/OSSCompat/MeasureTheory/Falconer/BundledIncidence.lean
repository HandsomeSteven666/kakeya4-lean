      (∀ c, d top ≤ c → ∀ q ∈ Q, prefixFiber Q c (q.take c) = prefixFiber L c (q.take c)) ∧
      (∀ b ∈ bs, ScalarPathLevel Q (d b.start) (d b.stop)
