        integral_mono hfi ((integrable_const _).add ((integrable_const 1).indicator hG)) hpoint
      _ = _ := by
        rw [integral_add (integrable_const _) ((integrable_const 1).indicator hG),
          integral_indicator_const (1 : ℝ) hG]
