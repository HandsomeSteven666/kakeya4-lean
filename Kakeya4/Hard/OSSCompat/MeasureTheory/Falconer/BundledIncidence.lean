    _ ≤ (K:ℝ)*|x-y|+|q| *|x-y| := by
      rw [abs_mul]
      exact add_le_add (by simpa only [Real.dist_eq] using hm.dist_le_mul x hx y hy) le_rfl
    _ = ((K:ℝ)+|q|)*|x-y| := by ring

