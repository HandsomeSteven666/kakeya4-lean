    calc
      _ ≤ ∑ p ∈ P, f p := Finset.sum_le_sum_of_subset_of_nonneg hAP (fun p _ _ => hf p)
      _ ≤ B*(P.card:ℝ)^2 := henergy
      _ = b*(ρ*(P.card:ℝ)) := by dsimp [b]; field_simp
      _ ≤ _ := mul_le_mul_of_nonneg_left hsize hb.le
