  rw [he]
  apply abs_le.mpr
  have hhalf : (d:ℝ)*(v-u)/N = 2*((d:ℝ)/2*(v-u)/N) := by ring
  rw [hhalf] at hh
  constructor <;> linarith [hh.1,hh.2]

end Falconer.Regularization

