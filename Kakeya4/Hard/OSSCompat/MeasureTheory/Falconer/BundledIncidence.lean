    obtain ⟨f1,hf1,hb1⟩ := ih P' (fun n => lo (n+1)) (fun n => hi (n+1)) S1 hP1 hn' hs'
    let f : (Fin (N+1) → Bool) → ℝ := fun w => if w 0 = true then f1 (Fin.tail w) else f0 (Fin.tail w)
