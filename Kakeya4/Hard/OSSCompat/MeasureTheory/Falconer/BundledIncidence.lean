    apply finite_low_half P f hb (fun x _ => hf x)
    change (∑ x ∈ P, ∑ y ∈ P, k x y) ≤ _
    convert henergy using 1
    ring
  have hSc : 0 < (S.card:ℝ) := by linarith only [hhalf,hPc]
  have hS : S.Nonempty := Finset.card_pos.mp (Nat.cast_pos.mp hSc)
