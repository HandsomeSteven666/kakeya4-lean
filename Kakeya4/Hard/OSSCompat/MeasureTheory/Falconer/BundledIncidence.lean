        ∀ u ∈ prefixChildren R (d c.start) (d c.cut) p,
        ∀ v ∈ prefixChildren R (d c.start) (d c.cut) p,
        u ≠ v → gap c ≤ |scalarPathCenter u-scalarPathCenter v| := by
      intro c hc p hp u hu v hv huv
