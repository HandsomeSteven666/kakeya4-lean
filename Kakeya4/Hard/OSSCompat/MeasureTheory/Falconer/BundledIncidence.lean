      rw [he]
      have hh := hlower z hz
      have hp := mul_nonneg (sub_nonneg.mpr (hqt.trans hts).le) hz.1
      change 0 ≤ m z-q*z
      nlinarith
  have hF1 : F 1 = m 1-q := by
    obtain ⟨z,hz,he,_⟩ := profileSuffixMinimum_attained hgc
      (show (1:ℝ) ∈ Icc 0 1 by constructor <;> norm_num)
