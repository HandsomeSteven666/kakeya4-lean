        (hc.trans ((hd hchain.start_le).trans (hd hsc))) F hFn
    · intro c hc q hq
      rw [hfiberQ c ((hd hsb).trans hc) q hq]
      exact scalarPruneLeaves_fiber L (hd b.cut_le_stop) hc F (hQR hq)
    · intro c hc
      rcases List.mem_cons.mp hc with heq | hc
      · subst c
