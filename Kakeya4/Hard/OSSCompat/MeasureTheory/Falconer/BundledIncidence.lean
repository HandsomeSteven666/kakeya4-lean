    _ ≤ ∑ _i ∈ Finset.Ico t M, B := Finset.sum_le_sum hk
    _ = B*(M-t) := by simp [Nat.mul_comm]
    _ ≤ _ := Nat.mul_le_mul_left B (scalar_nonporous_tail_length k n hend)

