variable {d : ℕ}

abbrev blockDepth (N B i : ℕ) : ℕ := N-i*B

noncomputable def blockLabel (L : Finset (CellPath d)) (N B : ℕ)
    (f : CellPath d → List ℕ) : ℕ → CellPath d → List ℕ
